# ==============================================================================
# Cube Cad Center - Comprehensive Environment Configuration Template
# All secrets must be supplied via serverless environment variables in production.
# ==============================================================================

# Server & Hosting Environment
PORT=3000
NODE_ENV=production
SITE_URL=https://cubecadcenter.co

# Cryptographic Token Secret (MANDATORY: No default fallback in production)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=your_64_character_hex_jwt_secret_key_here

# Administration Security & Credentials (MANDATORY: No default admin password)
ADMIN_NAME="Cube Cad Admin"
ADMIN_EMAIL=cubecadcenter0711@gmail.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Telecaller Desk Initial Credentials
CALLER_NAME="Primary Telecaller Desk"
CALLER_EMAIL=caller@cubecadcenter.com
CALLER_PASSWORD=your_strong_telecaller_password_here

# Booking Security & Spam Protection
REQUIRE_PHONE_OTP=false
TURNSTILE_SECRET=your_cloudflare_turnstile_secret_key_here

# ------------------------------------------------------------------------------
# NOTIFICATIONS: EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM="Cube Cad Center <noreply@cubecadcenter.co>"
EMAIL_REPLY_TO="info@cubecadcenter.co"

# Provider 1: Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key_here

# Provider 2: Brevo (Alternative)
BREVO_API_KEY=xkeysib_your_brevo_api_key_here

# Provider 3: Custom SMTP / Nodemailer (Alternative)
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# NOTIFICATIONS: SMS CONFIGURATION (India TRAI DLT Compliant)
# ------------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=msg91

# TRAI DLT Registration Identifiers
SMS_SENDER_ID=CUBCAD
DLT_ENTITY_ID=1101xxxxxxxxxxxx
DLT_TEMPLATE_ID_RECEIVED=1207xxxxxxxxxxxx
DLT_TEMPLATE_ID_CONFIRMED=1207xxxxxxxxxxxx
DLT_TEMPLATE_ID_CANCELLED=1207xxxxxxxxxxxx
DLT_TEMPLATE_ID_OTP=1207xxxxxxxxxxxx

# SMS Gateways
MSG91_AUTH_KEY=your_msg91_auth_key_here
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Optional: Receive instant admin SMS on each booking
ADMIN_PHONE=+919978999694

# ------------------------------------------------------------------------------
# MANAGED DATABASE & AUTH: GOOGLE CLOUD FIRESTORE / FIREBASE
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=cube-cad-center
FIREBASE_AUTH_DOMAIN=cube-cad-center.firebaseapp.com
FIREBASE_STORAGE_BUCKET=cube-cad-center.firebasestorage.app
FIREBASE_APP_ID=1:601288999504:web:b3cd86b733d244650fc755
FIREBASE_MEASUREMENT_ID=G-MLRGQ6FRD3
FIREBASE_API_KEY=AIzaSyDBdKpF_64kpxJ3JxBuRAMjRBCVnMisorI

# Dedicated Server-Side Service Account for Production Firestore Access
# Paste entire JSON string of Google Cloud Service Account key:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"cube-cad-center","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@cube-cad-center.iam.gserviceaccount.com"}
