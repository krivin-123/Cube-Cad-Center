PORT=3000
NODE_ENV=production
SECRET_KEY=your_jwt_secret_key_here

# Admin Credentials (Bootstrap initial admin access)
ADMIN_NAME=Cube Cad Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Telecaller Credentials (Bootstrap initial caller access)
CALLER_NAME="Primary Telecaller Desk"
CALLER_EMAIL=caller@example.com
CALLER_PASSWORD=your_strong_caller_password_here

# Firebase Web Client Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
FIREBASE_API_KEY=your_firebase_web_api_key_here

# Firebase Admin SDK Credentials (Dedicated Server-Side Service Account for Production Firestore Access)
# Option 1: Entire JSON content of Google Service Account key (as string or base64)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_firebase_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your_project.iam.gserviceaccount.com"}

# Option 2 (Alternative): Individual fields
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
